# Connection string for your own database. USER, PASSWORD, HOST and PORT are
# placeholders: put your real values in .env, which is not committed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/cerebrumkit
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First-run LLM seed. On the first migration these three values are copied into
# the `platforms` table, and from then on the admin panel owns the connection:
# Settings -> LLM Connections is where you change provider, URL, key or model.
# Only used when the table is still empty, so changing them later has no effect.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# The accounts seed.py creates. All three are required - nothing is hardcoded in
# the source, so pick a password that is not used anywhere else.
SEED_ADMIN_EMAIL=
SEED_CLIENT_EMAIL=
SEED_PASSWORD=
SEED_ADMIN_COUNTRY=CN
SEED_CLIENT_COUNTRY=CN
