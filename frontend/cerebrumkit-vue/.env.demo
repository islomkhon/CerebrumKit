# Settings for `npm run build:demo`, which produces the static build published to
# GitHub Pages. Vite loads this file only for `--mode demo`, so nothing here
# reaches an ordinary build or a deployment.
#
# VITE_DEMO makes the panel answer from src/demo/fixtures.json instead of the
# API, and lets VITE_API_URL stay unset: there is no backend to point at.
VITE_DEMO=1

# VITE_BASE is deliberately not set here. The workflow passes the repository's
# own subpath, so a fork publishes correctly without editing this file.
